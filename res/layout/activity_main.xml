<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>

    <!-- 主内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="12dp">

            <ImageButton
                android:id="@+id/btnDrawer"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@null"
                android:contentDescription="@string/drawer_title"
                android:src="@drawable/ic_menu"
                android:tint="@color/text_light" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/text_light"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 聊天下显示「设置聊天背景」，其余页面显示积分 -->
            <TextView
                android:id="@+id/tvPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_weight="0"
                android:background="@drawable/bg_top_chip"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="52dp"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:text="0 分"
                android:textColor="#FFD75E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="visible" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部 Dock：悬浮玻璃条，四角圆润；上层有一块指示当前选择的层 -->
        <FrameLayout
            android:id="@+id/dockWrap"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="14dp">

            <!-- 玻璃底板 -->
            <FrameLayout
                android:id="@+id/dockGlass"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 当前选择层：半透明浅蓝，跟随选中项滑动（在文字下层） -->
            <View
                android:id="@+id/dockIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_dock_pill"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tabChat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icChat"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/tab_chat"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tab_chat" />

                    <TextView
                        android:id="@+id/tvChat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tab_chat"
                        android:textColor="#FF000000"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabFriends"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icFriends"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/tab_friends"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tab_friends" />

                    <TextView
                        android:id="@+id/tvFriends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tab_friends"
                        android:textColor="#FF000000"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tabMe"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icMe"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/tab_me"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_tab_me" />

                    <TextView
                        android:id="@+id/tvMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/tab_me"
                        android:textColor="#FF000000"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 左侧抽屉：遮罩 + 面板 -->
    <FrameLayout
        android:id="@+id/drawerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/drawerMask"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/mask" />

        <LinearLayout
            android:id="@+id/drawerPanel"
            android:layout_width="270dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/bg_drawer"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@color/primaryDark"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:text="@string/drawer_title"
                android:textColor="@color/text_drawer"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/drawerBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
