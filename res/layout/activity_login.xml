<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary">

    <!-- 视频背景：放 assets/login_bg.mp4 即可启用，没有就显示纯色背景 -->
    <VideoView
        android:id="@+id/videoBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 视频上方压一层暗色，保证文字可读 -->
    <View
        android:id="@+id/videoMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/boxLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="40dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <!-- 打字机效果标题 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_light"
                android:textSize="20sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/tvCaret"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_light"
                android:textSize="20sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:text="|" />
        </LinearLayout>

        <!-- 登录中提示（顶部） -->
        <TextView
            android:id="@+id/tvLogging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="正在使你登录，请稍等!"
            android:textColor="#FFB74D"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 6 秒进度条 -->
        <ProgressBar
            android:id="@+id/pbLogin"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/pb_green"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:hint="@string/hint_user"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_sub"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_pass"
            android:inputType="textPassword"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_sub"
            android:textSize="14sp" />

        <!-- UID：注册时填写，注册后不可自行更改 -->
        <EditText
            android:id="@+id/edUid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_uid"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_sub"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUidTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/uid_warn"
            android:textColor="#FFB74D"
            android:textSize="11sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/edInvite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_invite"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_sub"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_btn"
            android:text="@string/btn_login"
            android:textColor="@color/text_light"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:text="@string/btn_register"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:text="@string/btn_web_login"
            android:textColor="@color/text_sub"
            android:textSize="14sp" />

        <!-- 忘记密码：注册按钮下方 -->
        <TextView
            android:id="@+id/btnForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal"
            android:padding="8dp"
            android:text="忘记密码？"
            android:textColor="@color/sky"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/web_login_tip"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
