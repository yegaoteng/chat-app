<?xml version="1.0" encoding="utf-8"?>
<!--
  开屏画面。

  自定义图片：放到 app/assets/ 目录，命名为
      splash.png  或  splash.jpg  或  splash.webp
  任意一种格式都行，程序自动识别。

  ⚠ 不要放进 res/drawable！Android 资源以「文件名去扩展名」为资源名，
    若 drawable 下同时出现 splash.png 与 splash.jpg，
    构建会失败：Duplicate resources: drawable/splash。
    assets 目录无此限制，故统一用 assets。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D0D16">

    <!-- 开屏视频：assets 里有 splash.mp4 时优先播视频，播完才进登录页 -->
    <VideoView
        android:id="@+id/vvSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:adjustViewBounds="false"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <ProgressBar
        android:id="@+id/pbSplash"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvSplashTip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="26dp"
        android:textColor="#CCFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
