<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 在线条：改成容器，逐个用户独立上色（整段 Spannable 没法做流动效果）。
         marginTop=-2dp 让它整体上移 2px -->
    <LinearLayout
        android:id="@+id/tvOnline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        android:background="@color/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 当前会话背景：不透明度 20%，让消息更清楚 -->
        <ImageView
            android:id="@+id/ivChatBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.2"
            android:adjustViewBounds="false"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ListView
            android:id="@+id/lvMsg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:cacheColorHint="#00000000"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:padding="8dp"
            android:stackFromBottom="true"
            android:transcriptMode="alwaysScroll" />

        <!-- 发送后的轻量加载提示 -->
        <ProgressBar
            android:id="@+id/pbSending"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- 切换频道/私聊时的加载提示 -->
        <LinearLayout
            android:id="@+id/loadingBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CCFFFFFF"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="聊天数据加载中…"
                android:textColor="@color/text_sub"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 输入区：功能按钮在上，输入框在下且占满宽度 -->
    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingTop="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnImg"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip_glass"
                android:minWidth="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="发送图片"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnUp"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_chip_glass"
                android:minWidth="0dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="我的上传"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_sub"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 引用条：长按消息选「引用」后显示 -->
        <LinearLayout
            android:id="@+id/quoteBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_quote"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="5dp"
            android:paddingRight="6dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQuote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_sub"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnQuoteCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="4dp"
                android:text="✕"
                android:textColor="@color/text_sub"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edMsg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_msg"
                android:maxLines="4"
                android:minHeight="42dp"
                android:padding="10dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text_sub"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_btn"
                android:minWidth="64dp"
                android:text="@string/btn_send"
                android:textColor="@color/text_light"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
