<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 频道标题行：「我的频道」与「加入频道」同一行 -->
    <LinearLayout
        android:id="@+id/chanBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/me_channels"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnJoin"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_card"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/ch_join"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 频道列表：与好友一样占满整行 -->
    <ListView
        android:id="@+id/lvChannel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

    <!-- 好友标题行 -->
    <LinearLayout
        android:id="@+id/friendBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="好友"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReq"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_card"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/fr_requests"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_btn"
            android:minWidth="0dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/fr_add"
            android:textColor="@color/text_light"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvFriend"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />
</LinearLayout>
