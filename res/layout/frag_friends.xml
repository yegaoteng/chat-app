<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:padding="8dp"
        android:text="@string/me_channels"
        android:textColor="@color/text_sub"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <ListView
            android:id="@+id/lvChannel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@null"
            android:nestedScrollingEnabled="false" />

        <Button
            android:id="@+id/btnJoin"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_card"
            android:text="@string/ch_join"
            android:textColor="@color/accent"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="好友"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnReq"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_card"
            android:text="@string/fr_requests"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_btn"
            android:text="@string/fr_add"
            android:textColor="@color/text_light"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvFriend"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />
</LinearLayout>
