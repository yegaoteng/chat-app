<?xml version="1.0" encoding="utf-8"?>
<!-- 选中层：半透明浅蓝 + 深色描边 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#55258CFF"
                android:startColor="#887FBFFF"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#FF1B4DB0" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- 顶部的一道高光，让药丸有厚度 -->
    <item android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#4DFFFFFF"
                android:type="linear" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
